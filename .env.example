# RDS collector connection. Replace placeholders locally/inside EC2 only.
DATABASE_URL=mysql+pymysql://collector_user:CHANGE_ME@your-rds-endpoint:3306/review_pipeline?charset=utf8mb4

# Used by the future MCP server; this account must remain read-only.
MCP_DATABASE_URL=mysql+pymysql://mcp_user:CHANGE_ME@your-rds-endpoint:3306/review_pipeline?charset=utf8mb4
MCP_AUTH_TOKEN=

# Optional deployment override. Omit locally to run all registered sites.
# EC2 currently uses: COLLECTOR_SITES=kakao tripdotcom
# COLLECTOR_SITES=kakao tripadvisor tripdotcom
