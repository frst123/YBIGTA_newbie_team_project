# 실제 값은 절대 커밋하지 마세요. 이 파일을 .env로 복사한 뒤 채워 넣으세요.

# csv(로컬 개발) 또는 rds(EC2 배포)
DATA_BACKEND=csv

# DATA_BACKEND=csv일 때 사용
CSV_DATA_GLOB=data/preprocessed_reviews_*.csv

# DATA_BACKEND=rds일 때 필수
# 예: mysql+pymysql://mcp_user:<password>@<rds-private-endpoint>:3306/<db>?charset=utf8mb4
DATABASE_URL=
REVIEW_TABLE=

# HTTP 서버 인증 토큰 (예: openssl rand -hex 32 로 생성)
MCP_AUTH_TOKEN=

MCP_HOST=0.0.0.0
MCP_PORT=8000

# DNS rebinding 방어: 실제 접근에 쓰는 Host를 추가 (예: <EC2-public-ip>:*, 도메인)
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,testserver
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# 분석용 최대 조회 행 수 (100~20000)
MAX_ANALYSIS_ROWS=5000
